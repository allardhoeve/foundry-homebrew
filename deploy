#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SECRETS_FILE="$SCRIPT_DIR/.deploy-secrets"

if [[ ! -f "$SECRETS_FILE" ]]; then
  echo "Error: secrets file not found: $SECRETS_FILE" >&2
  echo "Create it with DEPLOY_USER, DEPLOY_HOST, and DEPLOY_BASE." >&2
  exit 1
fi

source "$SECRETS_FILE"

if [[ -z "${DEPLOY_USER:-}" || -z "${DEPLOY_HOST:-}" || -z "${DEPLOY_BASE:-}" ]]; then
  echo "Error: .deploy-secrets must define DEPLOY_USER, DEPLOY_HOST, and DEPLOY_BASE." >&2
  exit 1
fi

cd "$SCRIPT_DIR/module"

# Stamp module.json with version from latest git tag
TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0")
VERSION="${TAG#v}"
sed -i '' "s/\"version\": \"[^\"]*\"/\"version\": \"$VERSION\"/" module.json
echo "Stamped module.json with version $VERSION"

DEST="${DEPLOY_USER}@${DEPLOY_HOST}:${DEPLOY_BASE}"

echo "Deploying to $DEST"
rsync -aizR \
  module.json src/ styles/ macros/ assets/ \
  "$DEST"

# Restore module.json to avoid dirty working tree
cd "$SCRIPT_DIR"
git checkout -- module/module.json
